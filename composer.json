{
  "name": "diesellaptops/pkg-laravel-throttling",
  "description": "Reusable Laravel throttling package for Diesel APIs",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0",
    "illuminate/cache": "^12.0",
    "illuminate/http": "^12.0",
    "illuminate/config": "^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Diesellaptops\\DieselThrottling\\": "src/",
      "Diesellaptops\\DieselThrottling\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Diesellaptops\\DieselThrottling\\DieselThrottlingProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
